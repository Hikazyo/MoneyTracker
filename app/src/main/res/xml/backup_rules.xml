<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下（API ≤30）的备份规则，由 android:fullBackupContent 引用。

  与 data_extraction_rules.xml 是同一件事的两套语法：API 31+ 读那份，API ≤30 读这份。
  两份都要写，只写一份的话另一半设备仍会按「全量备份」处理。

  这里的 <exclude> 语法在 API 31+ 上**不生效**（那份由 data_extraction_rules.xml 负责），
  保留它是为了覆盖 Android 11 及以下。
-->
<full-backup-content>
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="file" path="." />
  <exclude domain="root" path="." />
</full-backup-content>
