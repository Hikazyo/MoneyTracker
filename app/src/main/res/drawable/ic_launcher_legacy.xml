<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 7.x（API 24–25）用的传统图标：自适应图标是 API 26 才有的，
  更早的版本会回退到这个「背景 + 前景」合并好的整图。

  通过 mipmap-anydpi/ic_launcher.xml 引用（anydpi 不含版本限定符，
  因此对所有 API 生效，但在 API 26+ 会被 mipmap-anydpi-v26 的自适应图标覆盖）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角方形底 -->
    <path
        android:pathData="M30,10 H78 A20,20 0 0 1 98,30 V78 A20,20 0 0 1 78,98 H30 A20,20 0 0 1 10,78 V30 A20,20 0 0 1 30,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="98"
                android:endY="98"
                android:type="linear">
                <item android:offset="0" android:color="#FF0B5F58" />
                <item android:offset="1" android:color="#FF14B8A6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ¥ -->
    <path
        android:pathData="M40,38 L54,54 L68,38"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M54,54 L54,72"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M43,61 L65,61"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M43,68 L65,68"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
</vector>
